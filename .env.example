# Les variables Neon sont écrites dans .env.local par `neon deploy` (ou `neon env pull`).
# Ne jamais committer .env.local.

# Postgres (Neon) — poolée pour l'app, directe pour les migrations drizzle-kit.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth (Managed Better Auth) — écrites par neon deploy.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Secret des cookies de session, à générer soi-même (32 caractères minimum) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=

# Optionnel : slug de l'organisation utilisée par `npm run db:grant` (défaut : grenier-communautaire).
ORGANIZATION_SLUG=

# E-mails de notification aux demandeurs (Nodemailer, SMTP). Sans ces valeurs, rien n'est envoyé.
# E-mail OVH : SMTP_HOST=ssl0.ovh.net, SMTP_PORT=465, identifiant = adresse complète.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur affiché (par défaut SMTP_USER), ex. Grenier Communautaire <notifications@greniercommunautaire.org>
EMAIL_FROM=
# Adresse publique du site, utilisée pour les liens des e-mails.
SITE_URL=https://www.greniercommunautaire.org
